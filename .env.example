# Database driver: "mysql" or "sqlite"
DB_DRIVER=mysql

# MySQL connection string (used when DB_DRIVER=mysql)
DATABASE_URL=mysql://user:password@localhost:3306/datapilot

# SQLite file path (used when DB_DRIVER=sqlite)
# DATABASE_URL=./data.db

# Encryption key for sensitive fields (e.g. dbt database connection passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DBT_ENCRYPTION_KEY=

# JWT signing secret for user authentication (HS256)
# Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=

# ===== AI Agent (deepagents on LangGraph) =====
# Agent uses deepagents: file read/write (DB-backed), task planning (write_todos),
# subagents, human-in-the-loop approval, real token streaming.
#
# NOTE: 大模型配置已迁移至「系统设置 → 大模型配置」页面，在应用内维护。
# 支持多套预设（OpenAI / Anthropic 协议、自定义 base URL、temperature 等），
# 选一项「设为生效」即可。下方环境变量不再生效，仅保留历史注释。
#
# 旧版环境变量（已废弃，不再读取）：
#   LLM_PROVIDER / OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL

# ===== dbt Runtime Environment Initialization (Python venv) =====
# Root directory for all runtime environment venvs. Each environment gets its
# own subdirectory named after the environment. Defaults to ./venvs (relative
# to the process working directory).
# DBT_VENV_ROOT=./venvs

# Python interpreter used to create venvs (via `python -m venv`).
# When unset, the system auto-detects python3 then python.
# DBT_PYTHON_BIN=/usr/bin/python3

# Timeout (ms) for the pip install step during initialization. Default 10 min.
# DBT_INIT_TIMEOUT_MS=600000

# pip index URL. Defaults to Tsinghua TUNA mirror for faster installs in China.
# Set to https://pypi.org/simple to use the official PyPI source.
# DBT_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

