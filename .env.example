# Database driver: "mysql" or "sqlite"
DB_DRIVER=mysql

# MySQL connection string (used when DB_DRIVER=mysql)
DATABASE_URL=mysql://user:password@localhost:3306/datapilot

# SQLite file path (used when DB_DRIVER=sqlite)
# DATABASE_URL=./data.db

# Encryption key for sensitive fields (e.g. dbt database connection passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DBT_ENCRYPTION_KEY=

# JWT signing secret for user authentication (HS256)
# Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
